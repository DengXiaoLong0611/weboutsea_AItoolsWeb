# 浏览器公开配置：这里只能填 publishable key，禁止填 service_role key。
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 本地使用 http://localhost:3000；生产填写正式 https 域名，不带路径。
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 私人收藏库管理员邮箱，多个用英文逗号分隔；为空时拒绝所有访问。仅服务端使用。
PRIVATE_LIBRARY_ADMIN_EMAILS=

# 百炼宠物手绘：仅服务端使用，禁止加 NEXT_PUBLIC_ 前缀。
DASHSCOPE_API_KEY=
# 从百炼控制台复制与你的密钥/地域匹配的 API 地址，保留 /api/v1。
# 例如 https://你的业务空间ID.cn-beijing.maas.aliyuncs.com/api/v1
DASHSCOPE_BASE_URL=
DASHSCOPE_IMAGE_MODEL=qwen-image-2.1-pro

# DeepSeek 单模型聊天：仅服务端；禁止 NEXT_PUBLIC_ 前缀。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Optional server-side proxy for local Supabase connectivity; leave empty on hosted deployments.
SUPABASE_PROXY_URL=
# 手绘额度账本：仅服务端，绝对不要使用 NEXT_PUBLIC_ 前缀。
# 先运行 supabase/migrations/202610300001_drawing_credits.sql。
# Supabase 的 legacy service_role JWT key；不能填 publishable/anon key。
SUPABASE_SERVICE_ROLE_KEY=
# 至少 32 字符的随机私密值，各生产实例保持一致，重启不要更换。
DRAWING_COOKIE_SECRET=
