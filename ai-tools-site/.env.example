# Supabase Project Settings → API / Connect 中的公开信息；禁止使用 secret/service_role key。
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 本地使用 http://localhost:3000；生产填写正式 https 域名，不带路径。
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 私人收藏库管理员邮箱，多个用英文逗号分隔；为空时拒绝所有访问。仅服务端使用。
PRIVATE_LIBRARY_ADMIN_EMAILS=
