# 浏览器公开配置：这里只能填 publishable key，禁止填 service_role key。
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 本地使用 http://localhost:3000；生产填写正式 https 域名，不带路径。
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 私人收藏库管理员邮箱，多个用英文逗号分隔；为空时拒绝所有访问。仅服务端使用。
PRIVATE_LIBRARY_ADMIN_EMAILS=

# 百炼宠物手绘：仅服务端使用，禁止加 NEXT_PUBLIC_ 前缀。
DASHSCOPE_API_KEY=
# 从百炼控制台复制与你的密钥/地域匹配的 API 地址，保留 /api/v1。
# 例如 https://你的业务空间ID.cn-beijing.maas.aliyuncs.com/api/v1
DASHSCOPE_BASE_URL=
DASHSCOPE_IMAGE_MODEL=qwen-image-2.1-pro

# DeepSeek 单模型聊天：仅服务端；禁止 NEXT_PUBLIC_ 前缀。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# DeepSeek 每日额度：游客和登录账号各 20 次，UTC 零点恢复。
# 先应用 supabase/migrations/202611200002_chat_daily_quota.sql。
# 至少 32 字符的随机私密值。
# 用于签名访客 cookie；生产中需要所有实例保持一致。
CHAT_COOKIE_SECRET=
# Optional local testing only: memory (only honored by npm run dev).
# Quotas disappear on restart; never used by production builds. Leave empty for Supabase.
CHAT_QUOTA_STORE=

# Optional server-side proxy for local Supabase connectivity; leave empty on hosted deployments.
SUPABASE_PROXY_URL=
# 手绘额度账本：仅服务端，绝对不要使用 NEXT_PUBLIC_ 前缀。
# 先运行 supabase/migrations/202610300001_drawing_credits.sql。
# Supabase 的 legacy service_role JWT key；不能填 publishable/anon key。
SUPABASE_SERVICE_ROLE_KEY=
# 至少 32 字符的随机私密值，各生产实例保持一致，重启不要更换。
DRAWING_COOKIE_SECRET=

# Beside & Bloom: see docs/pet-portrait/异机开发交接-20261124.md for applied migrations.
PET_PORTRAIT_ENABLED=false
PET_PORTRAIT_DAILY_LIMIT=30
# Optional dedicated signing secret (32+ characters); otherwise uses DRAWING_COOKIE_SECRET.
PET_PORTRAIT_COOKIE_SECRET=
# Start with a Stripe test-mode secret. Never expose it to the browser.
STRIPE_SECRET_KEY=
# Optional support mailbox for customer-initiated physical print inquiries.
PET_PORTRAIT_PRINT_EMAIL=
# Signing secret for Stripe events delivered to /api/pet-portrait/webhook.
STRIPE_PORTRAIT_WEBHOOK_SECRET=
# Portrait generated/draft retention period in days.
PET_PORTRAIT_RETENTION_DAYS=30
# Bearer secret for protected POST /api/pet-portrait/worker (every minute)
# and POST /api/pet-portrait/cleanup (hourly). Supabase Cron is installed but paused.
# Worker maxDuration is 240 seconds; ensure the hosting plan supports it.
PET_PORTRAIT_CRON_SECRET=

# Secondary PIN for the private collection, after administrator authentication.
PRIVATE_LIBRARY_PIN=
